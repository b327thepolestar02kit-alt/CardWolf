{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() ? newData.child('hostUid').val() == auth.uid : data.child('hostUid').val() == auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid == $uid || auth.uid == root.child('rooms').child($roomId).child('hostUid').val())"
          }
        },
        "actions": {
          "$actionId": {
            ".write": "auth != null && (!newData.exists() ? auth.uid == root.child('rooms').child($roomId).child('hostUid').val() : (auth.uid == newData.child('uid').val() || auth.uid == root.child('rooms').child($roomId).child('hostUid').val()))",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid','type','actionId']) && (newData.child('uid').val() == auth.uid || auth.uid == root.child('rooms').child($roomId).child('hostUid').val()))"
          }
        },
        "privateCards": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && (auth.uid == $uid || auth.uid == root.child('rooms').child($roomId).child('hostUid').val())"
          }
        }
      }
    }
  }
}
